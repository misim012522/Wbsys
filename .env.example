APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# QR codes use this URL. For production use https://yourdomain.com. For local + phone/other device use your LAN IP (e.g. http://192.168.1.100:8000).
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=final_app
DB_USERNAME=root
DB_PASSWORD=

CENTRAL_DB_CONNECTION=${DB_CONNECTION}
CENTRAL_DB_HOST=${DB_HOST}
CENTRAL_DB_PORT=${DB_PORT}
CENTRAL_DB_DATABASE=final_app_central
CENTRAL_DB_USERNAME=${DB_USERNAME}
CENTRAL_DB_PASSWORD=${DB_PASSWORD}

TENANT_DB_CONNECTION=${DB_CONNECTION}
TENANT_DB_HOST=${DB_HOST}
TENANT_DB_PORT=${DB_PORT}
TENANT_DB_DATABASE=${DB_DATABASE}
TENANT_DB_USERNAME=${DB_USERNAME}
TENANT_DB_PASSWORD=${DB_PASSWORD}
TENANT_DB_PREFIX=tenant_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# GitHub Integration (for automatic release syncing)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
